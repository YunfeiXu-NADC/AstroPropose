# 后端数据库。演示时请改为服务器上的实际绝对路径。
DATABASE_URL=sqlite:////opt/dsl-rps/backend/astropropose-demo.db

# 上线前必须替换为随机强密钥，例如：openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

# Flask 运行参数
FLASK_ENV=production
FLASK_DEBUG=False

# 前端构建时使用；必须是最终用户浏览器可访问的后端地址。
NEXT_PUBLIC_API_URL=https://example.com/api-backend

